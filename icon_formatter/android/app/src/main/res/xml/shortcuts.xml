<?xml version="1.0" encoding="utf-8"?>
<!-- Static launcher shortcuts; MainActivity reads the shortcutAction extra. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="check_now"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_check_short"
        android:shortcutLongLabel="@string/shortcut_check_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.iconformatter.icon_formatter"
            android:targetClass="com.iconformatter.icon_formatter.MainActivity">
            <extra android:name="shortcutAction" android:value="check" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="refresh_day"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_refresh_short"
        android:shortcutLongLabel="@string/shortcut_refresh_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.iconformatter.icon_formatter"
            android:targetClass="com.iconformatter.icon_formatter.MainActivity">
            <extra android:name="shortcutAction" android:value="refresh" />
        </intent>
    </shortcut>
</shortcuts>
